{#- Artikelkarte; erwartet "post" (Eintrag aus collections.posts) -#}
{%- from "partials/icons.njk" import icon -%}
<li class="card">
  <a href="{{ post.url }}">
    <div class="card__media">
      <img src="{{ post.data.thumbnail }}" alt="{{ post.data.thumbnailAlt }}" loading="lazy" decoding="async"{% if post.data.thumbnailWidth %} width="{{ post.data.thumbnailWidth }}" height="{{ post.data.thumbnailHeight }}"{% endif %}>
      <div class="card__shade"></div>
      <span class="badge card__badge">{{ post.data.category }}</span>
    </div>
    <div class="card__body">
      <div class="meta">
        <span class="meta__item">{{ icon("calendar") }}<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate("short") }}</time></span>
        <span class="meta__item">{{ icon("clock") }}<span>{{ post.data.readTime }}</span></span>
      </div>
      <h3 class="card__title">{{ post.data.title }}</h3>
      <p class="card__text">{{ post.data.description }}</p>
      <span class="more">Read Article {{ icon("arrow-right") }}</span>
    </div>
  </a>
</li>

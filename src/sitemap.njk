---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.data.sitemap !== false %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {%- if item.data.modified %}
    <lastmod>{{ item.data.modified | isoDate }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
{#- Uebergang: Tool-Seiten, die noch keine Vorlage sind -#}
{%- for tool in tools %}
{%- if not (collections.all | hasUrl("/tools/" + tool.slug + "/")) %}
  <url>
    <loc>{{ site.url }}/tools/{{ tool.slug }}/</loc>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
